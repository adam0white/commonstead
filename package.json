{
  "name": "commonstead",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Commonstead: prepare a workshop store with eight residents who have their own limits.",
  "license": "MIT",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "stamp-release && vite build",
    "test": "node scripts/suite-lock.ts -- vitest run --testTimeout=180000 --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test",
    "ci": "pnpm run check && pnpm run build",
    "check:lane": "pnpm run lint && pnpm run typecheck",
    "deploy": "node scripts/deploy.mjs",
    "test:ui": "node scripts/simplify-ui-check.mjs"
  },
  "dependencies": {
    "@adam0white/human-framework": "4.8.1",
    "@adam0white/lab-client": "file:vendor/adam0white-lab-client-0.5.7.tgz",
    "@adam0white/lab-kit": "file:vendor/adam0white-lab-kit-0.5.24.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "fake-indexeddb": "6.2.6",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
