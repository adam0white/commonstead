{
  "name": "commonstead",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Commonstead: prepare a workshop store with eight residents who have their own limits.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "stamp-release && vite build",
    "test": "node scripts/suite-lock.ts -- vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "ci": "npm run check && npm run build",
    "check:lane": "npm run ci",
    "deploy": "node scripts/deploy.mjs",
    "test:ui": "node scripts/simplify-ui-check.mjs"
  },
  "dependencies": {
    "@adam0white/human-framework": "3.0.0",
    "@adam0white/lab-client": "file:vendor/adam0white-lab-client-0.4.11.tgz",
    "@adam0white/lab-kit": "file:vendor/adam0white-lab-kit-0.5.12.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents": false
  },
  "overrides": {
    "sharp": "0.35.5",
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
