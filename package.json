{
  "name": "commonstead",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Commonstead: prepare a workshop store with eight residents who have their own limits.",
  "license": "MIT",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "stamp-release && vite build",
    "test": "node scripts/suite-lock.ts -- vitest run --testTimeout=180000 --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test",
    "ci": "pnpm run check && pnpm run build",
    "check:lane": "pnpm run lint && pnpm run typecheck",
    "deploy": "node scripts/deploy.mjs",
    "test:ui": "node scripts/simplify-ui-check.mjs"
  },
  "dependencies": {
    "@adam0white/human-framework": "4.17.0",
    "@adam0white/lab-client": "file:vendor/adam0white-lab-client-0.5.7.tgz",
    "@adam0white/lab-kit": "file:vendor/adam0white-lab-kit-0.5.24.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "fake-indexeddb": "6.2.7",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
